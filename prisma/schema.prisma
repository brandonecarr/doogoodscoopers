// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Lead status enum for tracking lead progress
enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER
  NOT_INTERESTED
  WAITING_FOR_SIGNUP
  CONVERTED
  PHONE_REVIEW // created from a phone call by AI call notes — needs a human review
}

// Lead source to track where leads come from
enum LeadSource {
  QUOTE_FORM       // Started quote but didn't complete
  OUT_OF_AREA      // Out of service area interest
  CAREERS          // Job application
  COMMERCIAL       // Commercial service inquiry
  AD_LEAD          // Meta/Facebook ads via Privyr
  CUSTOMER         // Active Sweep&Go customer (for review-request / customer drips)
  INSTAGRAM        // Instagram comment → auto-DM commenter
  CANVASSER        // Door-to-door canvasser marked a home as a lead
}

// =====================
// QUOTE LEADS
// =====================
// People who started the quote form but didn't complete signup
model QuoteLead {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Status tracking
  status          LeadStatus  @default(NEW)
  archived        Boolean     @default(false)
  notes           String?     @db.Text

  // Followup and grading
  followupDate    DateTime?
  grade           String?     // A, B, C, D, F

  // Contact info
  firstName       String
  lastName        String?
  email           String?
  phone           String

  // Address
  address         String?
  city            String?
  zipCode         String

  // Service details
  numberOfDogs    String?
  frequency       String?
  lastCleaned     String?

  // Gate info
  gateLocation    String?
  gateCode        String?

  // Step tracking - which step did they abandon?
  lastStep        String?

  // Dogs info (stored as JSON)
  dogsInfo        Json?

  // Attribution — set when the lead arrived via a tracked link (e.g. Instagram auto-DM)
  sourceChannel   String?     // e.g. "instagram"
  instagramLeadId String?     // links back to the InstagramLead that converted

  // Last time this lead did something (created, or re-submitted a form). Lists
  // sort by this so a re-engaged lead floats to the top even though dedup
  // backdates createdAt to the earliest contact.
  lastActivityAt  DateTime?   @default(now())

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([zipCode])
  @@index([followupDate])
  @@index([instagramLeadId])
  @@index([lastActivityAt])
}

// =====================
// CANVASSER — field door-to-door
// =====================
// Isolated canvasser login accounts — created/managed from /admin, completely
// separate from the /app office/field/client Supabase staff system. Password is
// set by the rep via an emailed invite link (Brevo).
model Canvasser {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String? // null until they accept the invite
  active          Boolean   @default(true)
  inviteTokenHash String?   @unique // sha256 of the emailed invite token
  inviteExpires   DateTime?
  invitedAt       DateTime?
  lastLoginAt     DateTime?
  createdBy       String? // admin email who created them
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
}

// =====================
// FUNNELS — no-code lead funnels (Heyflow-style)
// =====================
// A funnel is stored as one JSON blob (steps/blocks/branching/theme/variants),
// mirroring StudioDraft. Rendered publicly at /f/<slug>; built in /admin/funnels.
model Funnel {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("draft") // draft | published
  data      Json // { theme, settings, variants: { A:{steps[]}, B?:{steps[]} }, split }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One visitor run through a funnel (for per-step analytics + attribution).
model FunnelSession {
  id          String    @id @default(cuid())
  funnelId    String
  slug        String
  variant     String    @default("A")
  attribution Json? // { fbp, fbc, fbclid, utm..., ig, ip, ua }
  leadId      String? // the QuoteLead / OutOfAreaLead created on completion
  leadType    String? // "quote" | "outofarea"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([funnelId])
  @@index([startedAt])
}

// A single step-level event (view / answer / next / submit / handoff / abandon).
model FunnelEvent {
  id        String   @id @default(cuid())
  sessionId String
  funnelId  String
  variant   String   @default("A")
  step      String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([funnelId, createdAt])
  @@index([sessionId])
}

// Every knocked door / dropped pin. Most never become leads; this is the map's
// memory. Owned by an individual canvasser (Supabase users.id). Never written
// by Sweep&Go. `clientKey` is a client-generated UUID for offline-safe upserts.
model CanvassVisit {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  canvasserId     String   // Supabase users.id of the rep who dropped the pin
  canvasserName   String   @default("")
  orgId           String   // Supabase org_id, carried from the session

  lat             Float
  lng             Float
  address         String?
  city            String?
  zipCode         String?

  status          String   @default("NOT_HOME") // NOT_HOME | NOT_INTERESTED | CALLBACK | INTERESTED | LEAD | DO_NOT_KNOCK
  notes           String?  @db.Text
  aiNotes         String?  @db.Text // AI-summarized notes from an at-the-door "Listen" session (audio never stored)

  canvasserLeadId String?  // set when this visit is marked as a lead
  clientKey       String   @unique // offline idempotency key

  @@index([canvasserId])
  @@index([status])
  @@index([zipCode])
  @@index([createdAt])
}

// The subset of visits marked as a lead — a first-class pipeline lead. Shares
// the common lead block so it flows into the /admin unified pipeline. Excluded
// from the existing Meta-ad drip campaigns (its own source, never cross-merged).
model CanvasserLead {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Status tracking (shared lead block)
  status          LeadStatus @default(NEW)
  archived        Boolean    @default(false)
  notes           String?    @db.Text
  aiNotes         String?    @db.Text // carried over from the canvass pin's at-the-door AI notes
  followupDate    DateTime?
  grade           String?

  // Contact info (all optional — a door knock may yield only a name)
  firstName       String?
  lastName        String?
  email           String?
  phone           String?

  // Address
  address         String?
  city            String?
  zipCode         String?

  // Canvasser attribution + origin
  canvasserId     String
  canvasserName   String     @default("")
  orgId           String
  visitId         String?    // the CanvassVisit this lead came from
  clientKey       String     @unique // offline idempotency key

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([zipCode])
  @@index([followupDate])
  @@index([canvasserId])
}

// A door-to-door territory: an admin-drawn map polygon with an estimated home
// count (from OpenStreetMap building footprints), optionally assigned to a rep.
model CanvassTerritory {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  name                  String
  polygon               Json     // ring of [lng, lat] points
  homeCount             Int      @default(0)
  areaAcres             Float?

  assignedCanvasserId   String?  // Canvasser.id
  assignedCanvasserName String?
  color                 String   @default("#6D3EF0")
  archived              Boolean  @default(false)
  createdBy             String

  @@index([assignedCanvasserId])
  @@index([archived])
}

// =====================
// OUT OF AREA LEADS
// =====================
// People interested but outside service area
model OutOfAreaLead {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Status tracking
  status          LeadStatus  @default(NEW)
  archived        Boolean     @default(false)
  notes           String?     @db.Text

  // Followup and grading
  followupDate    DateTime?
  grade           String?     // A, B, C, D, F

  // Contact info
  firstName       String
  lastName        String
  email           String
  phone           String
  zipCode         String

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([zipCode])
  @@index([followupDate])
}

// =====================
// CAREER APPLICATIONS
// =====================
model CareerApplication {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Status tracking
  status          LeadStatus  @default(NEW)
  archived        Boolean     @default(false)
  notes           String?     @db.Text

  // Followup and grading
  followupDate    DateTime?
  grade           String?     // A, B, C, D, F

  // Personal info
  firstName       String
  lastName        String
  email           String
  phone           String
  address         String
  city            String
  dateOfBirth     String?
  driversLicense  String?
  ssnLast4        String?

  // Employment eligibility
  legalCitizen    Boolean     @default(false)
  hasAutoInsurance Boolean    @default(false)
  convictedFelony Boolean     @default(false)

  // Work history
  references      String?     @db.Text
  currentEmployment String?   @db.Text
  workDuties      String?     @db.Text
  whyLeftPrevious String?     @db.Text
  mayContactEmployers Boolean @default(false)
  previousBossContact String? @db.Text

  // Motivation
  whyWorkHere     String?     @db.Text

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([followupDate])
}

// =====================
// COMMERCIAL INQUIRIES
// =====================
model CommercialLead {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Status tracking
  status          LeadStatus  @default(NEW)
  archived        Boolean     @default(false)
  notes           String?     @db.Text

  // Followup and grading
  followupDate    DateTime?
  grade           String?     // A, B, C, D, F

  // Contact info
  contactName     String
  propertyName    String
  email           String
  phone           String

  // Location
  city            String
  state           String
  zipCode         String

  // Additional notes from form
  inquiry         String?     @db.Text

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([followupDate])
}

// =====================
// AD LEADS (Meta/Facebook via Privyr)
// =====================
model AdLead {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Status tracking
  status          LeadStatus  @default(NEW)
  archived        Boolean     @default(false)
  notes           String?     @db.Text

  // Followup and grading
  followupDate    DateTime?
  grade           String?     // A, B, C, D, F

  // Contact info from ad form
  firstName       String?
  lastName        String?
  fullName        String?     // Some forms send full name instead
  email           String?
  phone           String?

  // Location (if provided)
  city            String?
  state           String?
  zipCode         String?

  // Ad campaign info
  adSource        String?     // e.g., "facebook", "instagram", "meta"
  campaignName    String?     // Name of the ad campaign
  adSetName       String?     // Ad set name
  adName          String?     // Individual ad name
  formName        String?     // Lead form name

  // Privyr specific fields
  privyrLeadId    String?     @unique  // Privyr's internal lead ID

  // Messenger link (for the Messenger-first drip). Set when we match this lead to
  // a Facebook Messenger thread; lastInboundAt tracks the 24h/7d send window.
  messengerPsid          String?    @unique
  messengerLastInboundAt DateTime?
  messengerGreetedAt     DateTime?  // set once we auto-greet, so we never greet twice

  // Store any additional custom fields as JSON
  customFields    Json?

  // Raw webhook payload for debugging
  rawPayload      Json?

  // Last time this lead did something (created, or re-submitted a form). Lists
  // sort by this so a re-engaged lead floats to the top even though dedup
  // backdates createdAt to the earliest contact.
  lastActivityAt  DateTime?   @default(now())

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([adSource])
  @@index([privyrLeadId])
  @@index([followupDate])
  @@index([lastActivityAt])
}

// =====================
// INSTAGRAM AUTOMATION (comment → auto-DM, ManyChat-style)
// =====================
// A keyword campaign: when someone comments a keyword on a post/reel, we send
// them a private-reply DM. Powered by the Meta webhook + a cron-drained queue.
model InstagramCampaign {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  name          String
  mediaId       String?   // specific post/reel to watch; null = any post
  keywords      String[]  // trigger words
  matchType     String    @default("partial") // "partial" | "whole"
  dmText        String    @db.Text // the DM to send (supports {username})
  publicReply   String?   @db.Text // optional public comment reply
  active        Boolean   @default(true)
  followGate    Boolean   @default(false) // require the user to follow first (phase 2)

  matchedCount  Int       @default(0)
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  adminEmail    String?

  @@index([active])
  @@index([mediaId])
}

// One matched comment → one queued/sent DM. commentId is unique so a comment is
// only ever answered once. Doubles as the send queue (status QUEUED) and the log.
model InstagramDm {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaignId   String
  commentId    String    @unique // the IG comment we privately reply to
  mediaId      String?
  igUserId     String?   // commenter's IG-scoped id
  username     String?
  commentText  String?   @db.Text
  text         String    @db.Text // rendered DM body

  status       String    @default("QUEUED") // QUEUED | SENT | SKIPPED | FAILED | RATE_LIMITED
  error        String?
  sentAt       DateTime?

  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
}

// A commenter turned into a lead. One row per person (deduped by igUserId, else
// username). Mirrors AdLead: all contact fields optional (Instagram gives us none
// up front) and filled in if/when the person converts through the tracked quote link.
model InstagramLead {
  id            String     @id @default(cuid())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Lead management (same shape as other lead models)
  status        LeadStatus @default(NEW)
  archived      Boolean    @default(false)
  notes         String?    @db.Text
  followupDate  DateTime?
  grade         String?

  // Who they are on Instagram
  igUserId      String?    // commenter's IG-scoped id (primary dedupe key)
  username      String?
  commentText   String?    @db.Text // their most recent matching comment
  commentId     String?    // most recent matching comment id
  mediaId       String?
  campaignId    String?
  campaignName  String?
  commentCount  Int        @default(1) // how many matching comments we've seen from them
  lastCommentAt DateTime?

  // Tracked link embedded in their DM (unique per person)
  trackingCode  String     @unique
  linkClickedAt DateTime?  // first time they clicked the tracked quote link
  linkClickCount Int       @default(0)

  // Contact info — only known after they convert through the quote form
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  zipCode       String?

  // Conversion
  convertedQuoteLeadId String?
  convertedAt          DateTime?

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([igUserId])
  @@index([username])
}

// One row per click of a tracked /ig/<code> link — the real per-click history
// (InstagramLead.linkClickCount/linkClickedAt stay as denormalized quick-stats).
model InstagramLinkClick {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  instagramLeadId String

  @@index([instagramLeadId])
  @@index([createdAt])
}

// Saved Content Studio carousels (the whole design as JSON: format + slides).
model StudioDraft {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  data      Json

  @@index([updatedAt])
}

// Cache of zip code → coordinates so the Leads map doesn't re-geocode.
// Populated on demand the first time a zip appears on the map.
model ZipGeo {
  zip       String   @id
  lat       Float
  lng       Float
  place     String   @default("")
  createdAt DateTime @default(now())
}

// AI-generated "trending" carousel templates for the Content Studio.
// A weekly cron researches current trending formats and appends fresh ones.
model StudioTemplate {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String   @default("")
  tags        String[] @default([])
  format      String   @default("square") // "square" | "portrait"
  data        Json // Omit<Slide,"id">[]
  source      String   @default("ai") // "ai" | "manual"
  trend       String   @default("") // the trend/insight this was based on
  active      Boolean  @default(true)

  @@index([active, createdAt])
}

// =====================
// ADMIN PUSH SUBSCRIPTIONS
// =====================
// Web Push subscriptions for admin followup notifications
model AdminPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// ADMIN USERS
// =====================
model AdminUser {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  email           String      @unique
  passwordHash    String
  name            String?

  @@index([email])
}

// =====================
// LEAD UPDATES
// =====================
// Track communication updates for leads
model LeadUpdate {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())

  // Which lead this update belongs to
  leadType        LeadSource
  leadId          String

  // Update content
  message         String      @db.Text
  communicationType String    // "phone_call", "text_message", "email", "in_person", "other"

  // Who added the update
  adminEmail      String

  @@index([leadType, leadId])
  @@index([createdAt])
}

// =====================
// ACTIVITY LOG
// =====================
// Track admin actions on leads
model ActivityLog {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())

  // Who performed the action
  adminEmail      String

  // What was the action
  action          String      // e.g., "status_change", "note_added", "viewed"

  // Which lead was affected
  leadType        LeadSource
  leadId          String

  // Details of the change
  details         Json?

  @@index([leadType, leadId])
  @@index([createdAt])
}

// =====================
// MESSAGE TEMPLATES
// =====================
// Reusable SMS templates for the per-lead compose box and campaigns.
model MessageTemplate {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  body        String   @db.Text
  category    String?  // "general" | "campaign"
  adminEmail  String

  @@index([category])
  @@index([createdAt])
}

// =====================
// LEAD MESSAGES
// =====================
// 2-way SMS conversation with a lead (via Quo). Polymorphic by leadType+leadId.
model LeadMessage {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())

  leadType     LeadSource
  leadId       String

  direction    String     // "INBOUND" | "OUTBOUND"
  body         String     @db.Text
  phone        String
  provider     String     @default("quo")
  quoMessageId String?    @unique
  status       String?    // QUEUED | SENT | DELIVERED | FAILED
  adminEmail   String?    // null for inbound / system
  campaignId   String?    // set when sent as part of a campaign

  @@index([leadType, leadId])
  @@index([createdAt])
  @@index([quoMessageId])
  @@index([campaignId])
}

// =====================
// CAMPAIGNS
// =====================
// Bulk SMS blasts to a filtered segment of leads.
model Campaign {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  name            String
  body            String   @db.Text // BLAST: the single message. DRIP: unused (steps hold the messages).
  type            String   @default("BLAST") // BLAST | DRIP
  status          String   @default("DRAFT") // BLAST: DRAFT|QUEUED|SENDING|SENT
  active          Boolean  @default(true) // DRIP: pause/resume enrollment + sends
  stopOnReply     Boolean  @default(true) // DRIP: halt a lead's sequence once they reply
  channel         String   @default("sms") // DRIP send channel: sms | messenger (messenger-first, SMS/email fallback)
  audienceFilter  Json?    // BLAST: segment criteria. DRIP: trigger { leadTypes: [...] }
  adminEmail      String

  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)

  steps           CampaignStep[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// A single message in a DRIP sequence. delayHours = wait before this step,
// relative to the previous step (step 0 = 0 = immediate on enrollment).
model CampaignStep {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder    Int
  body         String   @db.Text
  delayMinutes Int      @default(0) // wait before this step, relative to the previous (step 0 = 0)

  @@index([campaignId])
}

// =====================
// SMS OPT-OUT (do-not-contact)
// =====================
// A phone that replied STOP. Persistent + phone-keyed so we never message them
// again, even if a new lead with the same number arrives later.
model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique // normalized last-10 digits
  keyword   String? // the opt-out word received (STOP, UNSUBSCRIBE, ...)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Per-lead send queue for a campaign (drained by the process-campaigns cron).
model CampaignRecipient {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())

  campaignId   String
  leadType     LeadSource
  leadId       String
  phone        String
  name         String?

  status       String     @default("PENDING") // BLAST: PENDING|SENT|FAILED|SKIPPED. DRIP: ACTIVE|COMPLETED|STOPPED
  quoMessageId String?
  error        String?
  sentAt       DateTime?

  // DRIP progress
  currentStep  Int        @default(0)
  nextSendAt   DateTime?

  @@unique([campaignId, leadType, leadId])
  @@index([campaignId])
  @@index([status])
  @@index([nextSendAt])
}

// =====================
// SWEEP&GO CUSTOMER MIRROR
// =====================
// Read-only mirror of active Sweep&Go residential customers, refreshed hourly by
// the sync-customers cron. This is a ONE-WAY copy: the app only ever GETs from
// Sweep&Go and never writes back, so nothing done here can affect the Sweep&Go
// customer list. Cancellations are archived (active=false), not deleted.
model SweepandgoCustomer {
  id                String    @id @default(cuid())
  sngId             String    @unique // Sweep&Go client id, e.g. "rcl_2YYGKO9GRVII"

  // Mirrored fields (from GET /api/v1/clients/active)
  type              String? // e.g. "onboarding"
  sngStatus         String? // status reported by Sweep&Go, e.g. "active"
  firstName         String?
  lastName          String?
  email             String?
  address           String?
  zipCode           String?
  lat               Float? // geocoded from address for the customer map view
  lng               Float?
  geoPrecise        Boolean? // true = lat/lng is an exact address match; false = only the ZIP centroid; null = not yet evaluated
  geoAccuracy       String?  // Mapbox address accuracy (rooftop/parcel/point/interpolated) when precise
  homePhone         String?
  cellPhone         String?
  subscriptionNames String? // comma-joined, e.g. "2d-1xW,Sanitize w/ Regular Service"
  // Dog count, parsed from the plan code ("2d-1xW" = 2 dogs, once a week).
  // Sweep&Go's API exposes the count but NOT dog names or breeds.
  numberOfDogs      Int?
  oneTimeClient     Boolean   @default(false)
  channel           String?
  serviceDays       String?
  assignedTo        String?
  cleanupFrequency  String?

  // Customer's Sweep&Go "Created At" (signup) date. Not in the sync feed, so it's
  // backfilled for existing customers and set to first-seen time for new ones.
  startDate         DateTime?

  // Review tracking (local only — never synced to Sweep&Go). Set to REQUEST_SENT
  // automatically when a review-request drip texts the customer; editable by hand.
  reviewStatus      String    @default("NO_REVIEW") // NO_REVIEW | REQUEST_SENT | REVIEW_COMPLETE

  // Sync bookkeeping (local only)
  active            Boolean   @default(true) // present in the latest active pull
  firstSeenAt       DateTime  @default(now())
  lastSyncedAt      DateTime  @default(now())
  removedAt         DateTime? // when it dropped off the active list (archived)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active])
  @@index([zipCode])
  @@index([lastName])
  @@index([removedAt])
  @@index([startDate])
  @@index([reviewStatus])
}

// Marketing Director AI — a weekly action plan of checkable tasks, generated by
// Claude (grounded in the business's real numbers) and refreshed every week.
model MarketingPlan {
  id          String          @id @default(cuid())
  weekOf      DateTime        @unique // Monday (UTC) of the plan's week
  theme       String // short strategic theme for the week
  summary     String          @db.Text // the director's 1–2 paragraph briefing
  generatedAt DateTime        @default(now())
  model       String?
  createdAt   DateTime        @default(now())
  tasks       MarketingTask[]

  @@index([weekOf])
}

model MarketingTask {
  id          String        @id @default(cuid())
  planId      String
  plan        MarketingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekOf      DateTime // denormalized for quick "this week" queries
  title       String
  detail      String?       @db.Text // what/how, caption ideas, links
  channel     String // instagram | facebook | google | sms | email | referral | signage | reviews | website | local | ops
  priority    Int           @default(2) // 1 high · 2 medium · 3 low
  dayHint     String? // Mon..Sun (suggested day)
  effort      String? // e.g. "15 min", "1 hr"
  rationale   String?       @db.Text // why this matters (the director's reasoning)
  caption     String?       @db.Text // ready-to-paste social caption (post tasks)
  studioDraftId String? // linked Content Studio carousel draft (post tasks)
  status      String        @default("TODO") // TODO | DONE
  completedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([weekOf])
  @@index([status])
  @@index([planId])
}

// Customer-lifecycle events powering the Customers → Dashboard growth chart.
// SIGNUP / CANCELLATION drive the net-active curve; QUOTE is the top-of-funnel
// (web quote submissions). Seeded retroactively from historical CSVs and kept
// current going forward by the sync-customers cron. `dedupeKey` makes every
// source idempotent.
model SubscriptionEvent {
  id         String   @id @default(cuid())
  kind       String // SIGNUP | CANCELLATION | QUOTE
  occurredAt DateTime
  clientName String?
  email      String?
  city       String?
  zipCode    String?
  plan       String?
  revenue    Float?
  reason     String?
  source     String // csv-subscriptions | csv-quote | mirror-active | sync-customers
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())

  /// Test signups made while trialling the Sweep&Go onboarding flow. Sweep&Go
  /// cannot delete them, so they are flagged out of the growth stats here
  /// rather than destroyed — reversible, and the audit trail survives.
  excluded       Boolean @default(false)
  excludedReason String?

  @@index([kind])
  @@index([occurredAt])
  @@index([excluded])
}

// =====================
// REVIEWS
// =====================
// Tracks review requests and their outcomes (e.g. Google reviews). A row is
// created when we ask a customer for a review (auto after first cleanup, or
// manually) and updated as they complete / decline it.
model Review {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Who the review is from
  customerName   String
  phone          String?
  email          String?
  sngCustomerId  String? // optional link to a Sweep&Go customer (rcl_...)
  externalId     String? @unique // platform review id, e.g. "google:AbC..." for dedup on sync
  reply          String?  @db.Text // our public reply, if any

  // Request + outcome
  platform       String    @default("google") // google | yelp | facebook
  status         String    @default("REQUESTED") // PENDING | REQUESTED | COMPLETED | DECLINED
  rating         Int? // 1–5 once completed
  reviewText     String?   @db.Text
  reviewUrl      String? // link to the public review, if known

  requestedAt    DateTime?
  reviewedAt     DateTime?
  requestChannel String? // sms | email | manual

  notes          String?   @db.Text

  @@index([status])
  @@index([platform])
  @@index([createdAt])
  @@index([sngCustomerId])
}

// =====================
// APP SETTINGS (admin key/value)
// =====================
// Simple key/value config for the /admin section (e.g. review-source links,
// the Google "leave a review" link used by review-request SMS).
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Admin notifications — the bell in the header. One row per thing the owner
// should know about (a message that couldn't be delivered, a lead created from
// a call, Quo out of credits, ...). `dedupeKey` is unique so a recurring
// condition doesn't produce a wall of identical alerts.
model AdminNotification {
  id        String    @id @default(cuid())
  type      String // delivery_failed | lead_created | lead_replied | credits | system
  severity  String    @default("info") // info | warning | error
  title     String
  body      String?   @db.Text
  link      String? // where clicking it should go
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

// One row per Quo call whose transcript we've already run AI notes on.
// callId is the primary key, so a retried or concurrently-delivered webhook
// loses the insert race and skips — preventing duplicate leads and duplicate
// timeline notes for the same call.
model ProcessedCall {
  callId    String      @id
  action    String // created | enriched | noted | skipped
  leadType  LeadSource?
  leadId    String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

// =====================
// EMAIL MARKETING (newsletters)
// =====================

// Newsletter subscribers not already in the CRM (site signups, Brevo import).
model EmailContact {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  tags      String[] @default([])
  source    String? // import | form | manual
  status    String   @default("SUBSCRIBED") // SUBSCRIBED | UNSUBSCRIBED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Suppression list — enforced on every send (CAN-SPAM).
model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique // normalized lowercase
  reason    String? // unsubscribe | complaint | bounce
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A broadcast email (newsletter).
model EmailCampaign {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  name             String
  subject          String
  fromName         String?
  fromEmail        String?
  replyTo          String?
  html             String    @db.Text // compiled email body HTML
  designJson       Json? // GrapesJS project data, so the design can be re-opened
  audienceFilter   Json? // { leadTypes, withinDays, statuses }

  status           String    @default("DRAFT") // DRAFT | SCHEDULED | QUEUED | SENDING | SENT
  scheduledAt      DateTime?

  totalRecipients  Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  openCount        Int       @default(0)
  clickCount       Int       @default(0)
  bounceCount      Int       @default(0)
  unsubscribeCount Int       @default(0)

  adminEmail       String?

  @@index([status])
  @@index([createdAt])
}

// Per-recipient send + engagement row.
model EmailRecipient {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())

  campaignId  String
  email       String
  name        String?
  contactType String? // quote | ad | outofarea | commercial | career | customer | contact
  contactId   String?

  status      String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  resendId    String? // Resend email id, for webhook matching
  error       String?
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([status])
  @@index([resendId])
}

// Email automation (drip) — auto-enrolls new contacts and emails them a
// sequence over time (welcome, nurture, win-back). Mirrors the SMS drip engine.
model EmailAutomation {
  id         String   @id @default(cuid())
  name       String
  trigger    Json // { types: ["new_subscribers","new_customers","former_customers","quote","ad"] }
  active     Boolean  @default(true)
  sentCount  Int      @default(0)
  adminEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model EmailAutomationStep {
  id           String  @id @default(cuid())
  automationId String
  stepOrder    Int
  subject      String
  templateId   String? // preferred: send a designed template
  html         String? @db.Text // fallback inline HTML
  delayMinutes Int     @default(0)

  @@index([automationId])
}

model EmailAutomationRecipient {
  id           String    @id @default(cuid())
  automationId String
  contactType  String // subscriber | customer | former_customer | quote | ad
  contactId    String
  email        String
  name         String?
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | STOPPED
  currentStep  Int       @default(0)
  nextSendAt   DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  @@unique([automationId, contactType, contactId])
  @@index([automationId])
  @@index([status])
  @@index([nextSendAt])
}

// A saved, reusable audience (filter) for email campaigns.
model EmailSegment {
  id         String   @id @default(cuid())
  name       String
  filter     Json // { leadTypes, withinDays, statuses }
  adminEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

// Reusable email design (built in the visual designer).
model EmailTemplate {
  id         String   @id @default(cuid())
  name       String
  subject    String?
  html       String   @db.Text
  designJson Json? // GrapesJS project data for re-editing
  category   String?
  adminEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

/// Local route-planning scratchpad: the weekday the owner has *planned* to
/// service a customer. Never synced to Sweep&Go (SweepandgoCustomer is a
/// one-way read-only mirror). One row per customer. dayOfWeek: 0=Sun … 6=Sat.
/// Loose-coupled to SweepandgoCustomer by id (no FK) — orphan rows for
/// soft-deleted customers are harmless and simply ignored.
model RoutePlanAssignment {
  id         String   @id @default(cuid())
  customerId String   @unique
  dayOfWeek  Int
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dayOfWeek])
}

// =====================
// SWEEP&GO BILLING MIRROR
// =====================
// Invoices + payments pulled from Sweep&Go's Open API (v2) by the sync-billing
// cron. Money is stored in CENTS (integers) so lifetime sums never drift.
// Sweep&Go's billing feeds carry NO client id — only `client_name` — so
// `nameKey` (normalized "first last") is the join back to SweepandgoCustomer.
model SngInvoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  clientName      String?
  nameKey         String
  status          String? // paid | unpaid | ...
  type            String? // subscription | one_time | initial | prorated | variable
  category        String? // postpaid | prepaid | cleanup | variable
  billingInterval String? // monthly | weekly | bi-weekly | one_time | ...
  payMethod       String?
  totalCents      Int       @default(0)
  paidCents       Int       @default(0)
  refundedCents   Int       @default(0)
  remainingCents  Int       @default(0)
  tipCents        Int       @default(0)
  periodStart     DateTime?
  periodEnd       DateTime?
  sngCreatedAt    DateTime?
  syncedAt        DateTime  @default(now())

  @@index([nameKey])
  @@index([status])
  @@index([sngCreatedAt])
}
